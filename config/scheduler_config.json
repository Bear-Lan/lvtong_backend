{
  "gateRelease": {
    "minClearDistance": 27.0,
    "description": "受理后连续5帧距离>=27米或为0（无限远）才解除占用并抬杆；目标数不参与判断，其余情况持续车道占用"
  },
  "thresholds": [
    {
      "id": "initial_approach",
      "minDistance": 10.0,
      "maxDistance": 100.0,
      "description": "车辆接近中",
      "isActive": true,
      "deviceActions": {}
    },
    {
      "id": "gate_close_scan",
      "minDistance": 25,
      "maxDistance": 27,
      "description": "雷达距离25-27m：落杆",
      "isActive": true,
      "deviceActions": {
        "gate_001": {"action": "close", "params": {}}
      }
    },
    {
      "id": "xray_capture_trigger",
      "minDistance": 23,
      "maxDistance": 28,
      "description": "雷达距离23-28m：车身+200透视轮询",
      "isActive": true,
      "deviceActions": {}
    },
    {
      "id": "auto_capture_head",
      "minDistance": 26.5,
      "maxDistance": 28.5,
      "description": "车头拍照（前）",
      "isActive": true,
      "deviceActions": {
        "camera_001": {"action": "capture", "params": {"category": "head"}}
      }
    },
    {
      "id": "auto_capture_top",
      "minDistance": 20.0,
      "maxDistance": 22.5,
      "description": "车顶拍照",
      "isActive": true,
      "deviceActions": {
        "camera_001": {"action": "capture", "params": {"category": "top"}}
      }
    },
    {
      "id": "auto_capture_tail",
      "minDistance": 0,
      "maxDistance": 0,
      "description": "车尾拍照（光幕下沿记x，雷达<x-5触发，见 scheduler）",
      "isActive": false,
      "deviceActions": {}
    },
    {
      "id": "arrived",
      "minDistance": -1.0,
      "maxDistance": 0.5,
      "description": "车辆到达",
      "isActive": true,
      "deviceActions": {}
    }
  ],
  "plcStateRules": [
    {
      "ruleId": "safety_urgent_stop",
      "description": "急停安全联动：急停时禁止所有动作",
      "plcDeviceId": "plc_001",
      "isActive": true,
      "ruleType": "activation",
      "deviceIds": ["gate_001", "led_001", "xray_200", "xray_160"],
      "conditions": [
        {"stateKey": "urgentStopStatus", "expectedValue": true}
      ]
    },
    {
      "ruleId": "xray_interlock_200",
      "description": "200kV光栅联锁：光栅触发时允许出束",
      "plcDeviceId": "plc_001",
      "isActive": true,
      "ruleType": "activation",
      "deviceIds": ["xray_200"],
      "conditions": [
        {"stateKey": "lightGate200Status", "expectedValue": true}
      ]
    },
    {
      "ruleId": "xray_interlock_160",
      "description": "160kV光栅联锁：光栅触发时允许出束",
      "plcDeviceId": "plc_001",
      "isActive": true,
      "ruleType": "activation",
      "deviceIds": ["xray_160"],
      "conditions": [
        {"stateKey": "lightGate160Status", "expectedValue": true}
      ]
    }
  ]
}
